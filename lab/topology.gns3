                    "text": "R1-MikroTik",
                    "x": -4,
                    "y": -28
                },
                "locked": false,
                "name": "R1-MikroTik",
                "node_id": "68a30ffd-be1c-4866-8e63-e0bee2f7a266",
                "node_type": "qemu",
                "port_name_format": "ether{port1}",
                "port_segment_size": 0,
                "properties": {
                    "adapter_type": "virtio-net-pci",
                    "adapters": 8,
                    "bios_image": "",
