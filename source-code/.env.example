# Copy this file to .env and fill in real values. Never commit .env.
# Default credentials used for every device in inventory.yaml.
NET_USERNAME=admin
NET_PASSWORD=change-me

# Optional: a device can point to another prefix with `credentials: LAB`
# in inventory.yaml, which reads LAB_USERNAME / LAB_PASSWORD instead.
# LAB_USERNAME=
# LAB_PASSWORD=

# Cisco enable secret (optional)
# NET_SECRET=
