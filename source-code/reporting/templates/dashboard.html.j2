<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Báo cáo giám sát mạng – {{ generated_at }}</title>
<style>
  :root {
    --surface: #fcfcfb; --card: #ffffff; --ink: #0b0b0b; --ink-2: #52514b; --ink-3: #75746d;
    --hair: #e1e0d9; --ring: rgba(11,11,11,0.10);
    --good: #0ca30c; --warning: #fab219; --critical: #d03b3b; --info: #3b6fd0;
    --good-text: #006300; --track: #e8f0fb; --fill: #3b6fd0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --surface: #1a1a19; --card: #222220; --ink: #f2f1ec; --ink-2: #b9b8b0; --ink-3: #8c8b84;
      --hair: #2c2c2a; --ring: rgba(255,255,255,0.10);
      --good-text: #0ca30c; --info: #6f9be6; --track: #26324a; --fill: #6f9be6;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--surface); color: var(--ink);
         font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 1180px; margin: 0 auto; padding: 28px 24px 48px; }
  header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap;
           border-bottom: 1px solid var(--hair); padding-bottom: 16px; margin-bottom: 20px; }
  h1 { font-size: 22px; margin: 0 0 2px; font-weight: 650; }
  h2 { font-size: 16px; margin: 28px 0 10px; font-weight: 650; }
  .muted { color: var(--ink-3); }
  .meta { color: var(--ink-2); font-size: 13px; text-align: right; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .tile { background: var(--card); border: 1px solid var(--ring); border-radius: 10px; padding: 14px 16px; }
  .tile .label { color: var(--ink-2); font-size: 13px; }
  .tile .value { font-size: 30px; font-weight: 650; margin-top: 2px; }
  .tile .sub { color: var(--ink-3); font-size: 12px; }
  .card { background: var(--card); border: 1px solid var(--ring); border-radius: 10px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--hair); vertical-align: middle; }
  th { white-space: nowrap; color: var(--ink-2); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
  tr:last-child td { border-bottom: 0; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .nowrap { white-space: nowrap; }
  code { font: 12.5px ui-monospace, SFMono-Regular, Consolas, monospace; }
  .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
  .dot { width: 18px; height: 18px; border-radius: 50%; display: inline-grid; place-items: center;
         color: #fff; font-size: 11px; font-weight: 700; line-height: 1; }
  .dot.good { background: var(--good); } .dot.warning { background: var(--warning); color: #0b0b0b; }
  .dot.critical { background: var(--critical); } .dot.info { background: var(--info); }
  .meter { display: flex; align-items: center; gap: 8px; min-width: 120px; }
  .track { flex: 1; height: 8px; border-radius: 4px; background: var(--track); overflow: hidden; }
  .bar { height: 100%; border-radius: 4px; background: var(--fill); }
  .bar.warning { background: var(--warning); } .bar.critical { background: var(--critical); }
  .empty { padding: 18px; color: var(--ink-2); }
  details { background: var(--card); border: 1px solid var(--ring); border-radius: 10px; margin-bottom: 10px; }
  summary { cursor: pointer; padding: 12px 16px; font-weight: 600; display: flex; gap: 10px; align-items: center; }
  summary .muted { font-weight: 400; }
  .detail-body { padding: 0 16px 16px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .detail-body h3 { font-size: 13px; margin: 6px 0; color: var(--ink-2); font-weight: 600; }
  .detail-body table td, .detail-body table th { padding: 6px 8px; }
  footer { margin-top: 32px; color: var(--ink-3); font-size: 12px; }
  @media print { details { break-inside: avoid; } details:not([open]) .detail-body { display: grid; } }
</style>
</head>
<body>
<main>
{% macro status(level, label=None) -%}
  {%- set icons = {"good": "✓", "warning": "!", "critical": "✕", "info": "i"} -%}
  {%- set names = {"good": "Bình thường", "warning": "Cảnh báo", "critical": "Nghiêm trọng", "info": "Thông tin"} -%}
  <span class="pill"><span class="dot {{ level }}" aria-hidden="true">{{ icons[level] }}</span>{{ label or names[level] }}</span>
{%- endmacro %}

<header>
  <div>
    <h1>Báo cáo kiểm kê và giám sát trạng thái mạng</h1>
    <div class="muted">Lab GNS3 · mạng quản lý 192.168.100.0/24</div>
  </div>
  <div class="meta">Thời điểm quét: <strong>{{ generated_at }}</strong><br>Người thực hiện: {{ operator }}</div>
</header>

<section class="tiles" aria-label="Tổng quan">
  <div class="tile"><div class="label">Thiết bị trực tuyến</div>
    <div class="value">{{ online }}<span class="muted" style="font-size:18px"> / {{ total }}</span></div>
    <div class="sub">{{ offline }} thiết bị không kết nối được</div></div>
  <div class="tile"><div class="label">Cảnh báo nghiêm trọng</div>
    <div class="value">{{ critical }}</div><div class="sub">{{ status("critical", "cần xử lý ngay") if critical else "không có" }}</div></div>
  <div class="tile"><div class="label">Cảnh báo</div>
    <div class="value">{{ warning }}</div><div class="sub">{{ info }} thông tin</div></div>
  <div class="tile"><div class="label">Cổng có IP bị mất kết nối</div>
    <div class="value">{{ interfaces_alerted }}</div><div class="sub">trên {{ interfaces_total }} cổng đã quét</div></div>
</section>

<h2>Danh sách cảnh báo</h2>
<div class="card">
{% if alerts %}
  <table>
    <thead><tr><th>Mức độ</th><th>Thiết bị</th><th>Luật</th><th>Nội dung</th><th class="num">Thời gian</th></tr></thead>
    <tbody>
    {% for a in alerts %}
      <tr><td>{{ status(a.severity) }}</td><td><strong>{{ a.device }}</strong></td>
          <td><code>{{ a.rule }}</code></td><td>{{ a.message }}</td>
          <td class="num muted">{{ a.timestamp.strftime("%H:%M:%S") }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="empty">{{ status("good", "Không phát hiện bất thường") }}</div>
{% endif %}
</div>

<h2>Thiết bị</h2>
<div class="card">
  <table>
    <thead><tr><th>Trạng thái</th><th>Thiết bị</th><th>Hãng / phiên bản</th><th>Hostname</th>
      <th class="num">Uptime</th><th>CPU</th><th class="num">Cổng up</th><th class="num">OSPF</th><th>Serial / ID</th></tr></thead>
    <tbody>
    {% for d in devices %}
      {% if d.online %}{% set f = d.facts %}
      <tr>
        <td>{{ status(d.status) }}</td>
        <td><strong>{{ f.device }}</strong></td>
        <td>{{ f.vendor }}<br><span class="muted">{{ f.os_version or "—" }}</span></td>
        <td class="nowrap">{{ f.hostname or "—" }}</td>
        <td class="num nowrap">{{ f.uptime_seconds | uptime }}</td>
        <td>
          {% if f.cpu_percent is not none %}
          {% set level = "critical" if f.cpu_percent >= 95 else ("warning" if f.cpu_percent >= cpu_threshold else "") %}
          <div class="meter" title="CPU {{ '%.0f' % f.cpu_percent }}%">
            <div class="track"><div class="bar {{ level }}" style="width: {{ [f.cpu_percent, 100] | min }}%"></div></div>
            <span class="num">{{ "%.0f" % f.cpu_percent }}%</span></div>
          {% else %}—{% endif %}
        </td>
        <td class="num nowrap">{{ d.interfaces_up }} / {{ f.interfaces | length }}</td>
        <td class="num">{{ d.ospf_full }}</td>
        <td><code>{{ f.serial or "—" }}</code></td>
      </tr>
      {% else %}
      <tr>
        <td>{{ status("critical", "Mất kết nối") }}</td>
        <td><strong>{{ d.name }}</strong></td>
        <td colspan="7" class="muted">{{ d.error }}</td>
      </tr>
      {% endif %}
    {% endfor %}
    </tbody>
  </table>
</div>

<h2>Chi tiết từng thiết bị</h2>
{% for d in devices if d.online %}{% set f = d.facts %}
<details>
  <summary>{{ status(d.status, f.device) }} <span class="muted">{{ f.hostname or "" }} · {{ f.interfaces | length }} cổng · {{ f.ospf_neighbors | length }} OSPF neighbor · {{ f.arp_entries | length }} ARP</span></summary>
  <div class="detail-body">
    <div>
      <h3>Cổng mạng</h3>
      <table>
        <thead><tr><th>Cổng</th><th>Địa chỉ IP</th><th>Admin</th><th>Link</th></tr></thead>
        <tbody>
        {% for i in f.interfaces %}
          <tr><td><code>{{ i.name }}</code></td><td>{{ i.ip_address or "—" }}</td>
              <td>{{ "bật" if i.admin_up else "tắt" }}</td>
              <td>{% if i.oper_up %}{{ status("good", "up") }}{% elif not i.admin_up %}<span class="muted">tắt</span>{% elif i.ip_address %}{{ status("critical", "down") }}{% else %}<span class="muted">không dùng</span>{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div>
      <h3>OSPF neighbor</h3>
      {% if f.ospf_neighbors %}
      <table>
        <thead><tr><th>Router ID</th><th>Địa chỉ</th><th>Cổng</th><th>Trạng thái</th></tr></thead>
        <tbody>
        {% for n in f.ospf_neighbors %}
          <tr><td>{{ n.neighbor_id }}</td><td>{{ n.address }}</td><td><code>{{ n.interface }}</code></td>
              <td>{{ status("good" if n.state.lower().startswith("full") else "warning", n.state) }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="muted">Chưa có neighbor.</p>{% endif %}
      <h3>Bảng ARP</h3>
      {% if f.arp_entries %}
      <table>
        <thead><tr><th>IP</th><th>MAC</th><th>Cổng</th></tr></thead>
        <tbody>
        {% for e in f.arp_entries %}
          <tr><td>{{ e.ip }}</td><td><code>{{ e.mac }}</code></td><td><code>{{ e.interface }}</code></td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="muted">Trống.</p>{% endif %}
      <p class="muted" style="margin-top:10px">Mã băm cấu hình: <code>{{ (f.config_hash or "—")[:16] }}</code> · thu thập lúc {{ f.collected_at.strftime("%H:%M:%S") }}</p>
    </div>
  </div>
</details>
{% endfor %}

<footer>Tạo bởi Network Inventory Monitor (<code>python main.py scan</code>). Trang tĩnh, mở trực tiếp bằng trình duyệt, không cần kết nối mạng.</footer>
</main>
</body>
</html>
