digraph G {
  graph [rankdir=BT, fontname="DejaVu Sans", nodesep=0.25, ranksep=0.55, bgcolor="white", pad=0.15];
  node  [shape=plaintext, fontname="DejaVu Sans", fontsize=9.5];
  edge  [fontname="DejaVu Sans", fontsize=8.5, color="#4b5263"];
  AR [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263">
   <tr><td bgcolor="#dfe6f3"><i>«abstract»</i><br/><b><i>AnomalyRule</i></b></td></tr>
   <tr><td align="left" balign="left"><i>+ name : str</i><br/><i>+ evaluate(current, previous) : List[Alert]</i><br/># _alert(facts, severity, message)</td></tr></table>>];
  ME [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263">
   <tr><td bgcolor="#dfe6f3"><b>MonitoringEngine</b></td></tr>
   <tr><td align="left" balign="left">- _rules : List[AnomalyRule]<br/>- _snapshot_dir</td></tr>
   <tr><td align="left" balign="left">+ evaluate(facts, failures) : List[Alert]<br/>+ load_previous() / save_snapshot()</td></tr></table>>];
  R1 [label=<<table border="1" cellborder="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263"><tr><td><b>InterfaceDownRule</b></td></tr></table>>];
  R2 [label=<<table border="1" cellborder="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263"><tr><td><b>HighCpuRule</b><br/>threshold</td></tr></table>>];
  R3 [label=<<table border="1" cellborder="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263"><tr><td><b>OspfNeighborLostRule</b></td></tr></table>>];
  R4 [label=<<table border="1" cellborder="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263"><tr><td><b>RebootRule</b></td></tr></table>>];
  R5 [label=<<table border="1" cellborder="0" cellpadding="3" bgcolor="#f4f6fa" color="#4b5263"><tr><td><b>ConfigChangedRule</b></td></tr></table>>];
  AL [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fbf7e8" color="#4b5263">
   <tr><td bgcolor="#f3ead0"><i>«dataclass»</i><br/><b>Alert</b></td></tr>
   <tr><td align="left" balign="left">device, rule, severity, message, timestamp<br/>+ rank</td></tr></table>>];
  {R1 R2 R3 R4 R5} -> AR [arrowhead=empty];
  ME -> AR [dir=back, arrowtail=odiamond, label=" 1..*"];
  AR -> AL [style=dashed, arrowhead=vee, label=" tạo"];
  {rank=same; R1 R2 R3 R4 R5}
  {rank=same; ME AL}
}
