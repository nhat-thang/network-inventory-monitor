graph G {
  graph [layout=neato, overlap=false, splines=true, fontname="DejaVu Sans", bgcolor="white", pad=0.25];
  node  [fontname="DejaVu Sans", fontsize=10, style="rounded,filled", shape=box, color="#6b7487", fillcolor="#f4f6fa"];
  edge  [fontname="DejaVu Sans", fontsize=8.5, color="#4b5263", penwidth=1.3];
  PC  [label="Laptop Windows\nVMnet3 192.168.100.1\nPython + Netmiko", pos="0,5.2!", fillcolor="#e3ecfb"];
  CL  [label="Cloud (GNS3 VM, eth2)", pos="0,4.0!", shape=ellipse, fillcolor="#ffffff"];
  SW  [label="SW-Management\n(switch quản lý)", pos="0,2.8!", fillcolor="#eef3ec"];
  R1  [label="R1 · MikroTik CHR\nether1 .11 · RID 1.1.1.1", pos="-3.0,1.3!"];
  R2  [label="R2 · MikroTik CHR\nether1 .12 · RID 2.2.2.2", pos="3.0,1.3!"];
  VY1 [label="VY1 · VyOS\neth0 .21 · RID 3.3.3.3", pos="-3.0,-1.2!"];
  VY2 [label="VY2 · VyOS\neth0 .22 · RID 4.4.4.4", pos="3.0,-1.2!"];
  PC -- CL [label="  host-only VMnet3"];
  CL -- SW [label="  e4"];
  SW -- R1 [style=dashed, color="#8aa184", label="e0"];
  SW -- R2 [style=dashed, color="#8aa184", label="e1"];
  SW -- VY1 [style=dashed, color="#8aa184", label="e2"];
  SW -- VY2 [style=dashed, color="#8aa184", label="e3"];
  R1 -- R2   [label="ether2 – ether2\n10.0.12.0/30", color="#3b6fd0"];
  R1 -- VY1  [label="ether3 – eth1\n10.0.13.0/30", color="#3b6fd0"];
  R2 -- VY2  [label="ether3 – eth1\n10.0.24.0/30", color="#3b6fd0"];
  VY1 -- VY2 [label="eth2 – eth2\n10.0.34.0/30", color="#3b6fd0"];
}
