digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", ranksep=0.28, bgcolor="white", pad=0.15];
  node  [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
  edge  [color="#5b6475", arrowsize=0.8, penwidth=1.2];

  pres [label=<<table border="1" cellborder="1" cellspacing="5" cellpadding="6" bgcolor="#e3ecfb" color="#7f8db0">
    <tr><td colspan="2" border="0"><b>1. Lớp trình diễn</b></td></tr>
    <tr><td>Dòng lệnh – main.py<br/><font point-size="9">argparse: inventory, scan, backup [--every],<br/>diff, rollback, deploy &lt;template&gt;, web, --demo</font></td>
        <td>Giao diện web – web/<br/><font point-size="9">Flask, Jinja2; TaskManager chạy tác vụ nền,<br/>gửi tiến trình qua Server-Sent Events</font></td></tr></table>>];

  biz [label=<<table border="1" cellborder="1" cellspacing="5" cellpadding="6" bgcolor="#f4f6fa" color="#8a93a6">
    <tr><td colspan="6" border="0"><b>2. Lớp nghiệp vụ</b></td></tr>
    <tr><td colspan="6" bgcolor="#ffffff">services/NetworkService – điểm vào chung cho CLI và web</td></tr>
    <tr><td>inventory/<br/><font point-size="9">Inventory</font></td>
        <td>collectors/<br/><font point-size="9">FactsCollector</font></td>
        <td>monitoring/<br/><font point-size="9">MonitoringEngine, 6 luật<br/>ComplianceChecker, 5 tiêu chí</font></td>
        <td>backup/<br/><font point-size="9">BackupManager<br/>PeriodicRunner</font></td>
        <td>provisioning/<br/><font point-size="9">ConfigPusher<br/>(Jinja2)</font></td>
        <td>reporting/<br/><font point-size="9">MarkdownReport<br/>HistoryLog, AppLogger</font></td></tr></table>>];

  conn [label=<<table border="1" cellborder="1" cellspacing="5" cellpadding="6" bgcolor="#f4f6fa" color="#8a93a6">
    <tr><td colspan="3" border="0"><b>3. Lớp kết nối thiết bị</b></td></tr>
    <tr><td colspan="3">ConnectionManager (ThreadPoolExecutor)  ·  DeviceFactory  →  NetworkDevice (lớp trừu tượng)</td></tr>
    <tr><td>MikroTikDevice</td><td>VyOSDevice</td><td>CiscoIOSDevice</td></tr>
    <tr><td colspan="3" bgcolor="#eef3ec">Netmiko / Paramiko – SSH cổng 22</td></tr></table>>];

  data [label=<<table border="1" cellborder="1" cellspacing="5" cellpadding="6" bgcolor="#fbf7e8" color="#a99b6b">
    <tr><td colspan="4" border="0"><b>4. Lớp dữ liệu / inventory</b></td></tr>
    <tr><td>inventory.yaml<br/><font point-size="9">danh sách thiết bị</font></td>
        <td>.env<br/><font point-size="9">tài khoản (Credentials)</font></td>
        <td>provisioning/*.j2, *_vars.yaml<br/><font point-size="9">template và biến</font></td>
        <td>output/<br/><font point-size="9">snapshots, backups, reports/*.md,<br/>history.jsonl, logs</font></td></tr></table>>];

  lab [label=<<table border="1" cellborder="0" cellpadding="7" bgcolor="#eef3ec" color="#8aa184">
    <tr><td><b>Lab GNS3</b></td></tr><tr><td>R1, R2 (MikroTik CHR)<br/>VY1, VY2 (VyOS)<br/><font point-size="9">mạng quản lý 192.168.100.0/24</font></td></tr></table>>];

  pres -> biz -> conn;
  conn -> data [label=" đọc / ghi ", fontname="DejaVu Sans", fontsize=9, style=dashed];
  conn -> lab [label=" SSH ", fontname="DejaVu Sans", fontsize=9];
  {rank=same; conn; lab}
}
